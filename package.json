{
	"name": "matters-that-matter",
	"version": "0.1.1",
	"description": "Matters that Matter: an Obsidian plugin for personal work management",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"obsidian-plugin"
	],
	"author": "Manuel Delgado Tenorio",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"chrono-node": "2.10.2",
		"monkey-around": "3.0.0"
	}
}
